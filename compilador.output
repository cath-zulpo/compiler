Terminals unused in grammar

    '/'


Grammar

    0 $accept: program $end

    1 $@1: ε

    2 $@2: ε

    3 program: $@1 PROGRAM IDENT main_args ';' $@2 block '.'

    4 main_args: '(' main_idents ')'
    5          | ε

    6 main_idents: main_idents ',' IDENT
    7            | IDENT

    8 block: var sub_routines composite_command

    9 $@3: ε

   10 var: VAR $@3 declare_vars
   11    | ε

   12 declare_vars: declare_vars declare_var
   13             | declare_var

   14 $@4: ε

   15 $@5: ε

   16 declare_var: $@4 list_id_var ':' IDENT $@5 ';'

   17 list_id_var: list_id_var ',' IDENT
   18            | IDENT

   19 sub_routines: sub_routines sub_routine
   20             | ε

   21 sub_routine: procedure
   22            | function

   23 $@6: ε

   24 $@7: ε

   25 procedure: PROCEDURE IDENT $@6 args ';' $@7 block ';'

   26 $@8: ε

   27 $@9: ε

   28 function: FUNCTION IDENT $@8 args ':' IDENT ';' $@9 block ';'

   29 $@10: ε

   30 args: '(' $@10 list_args ')'
   31     | ε

   32 $@11: ε

   33 list_args: ref list_idents ':' IDENT $@11 ';' list_args
   34          | ref list_idents ':' IDENT

   35 list_idents: list_idents ',' IDENT
   36            | IDENT

   37 ref: VAR
   38    | ε

   39 $@12: ε

   40 composite_command: T_BEGIN $@12 commands T_END

   41 commands: command ';' commands
   42         | command who_cares

   43 who_cares: ';'
   44          | ε

   45 command: assignment
   46        | read
   47        | write
   48        | while
   49        | if
   50        | procedure_call

   51 $@13: ε

   52 assignment: IDENT $@13 ASSIGNMENT expression

   53 read: READ '(' list_args_read ')'

   54 $@14: ε

   55 list_args_read: IDENT $@14 ',' list_args_read
   56               | IDENT

   57 write: WRITE '(' list_args_write ')'

   58 list_args_write: list_args_write ',' expression
   59                | expression

   60 $@15: ε

   61 $@16: ε

   62 while: WHILE $@15 expression $@16 DO nested_commands

   63 if: if_then else

   64 $@17: ε

   65 $@18: ε

   66 if_then: IF $@17 expression $@18 THEN nested_commands

   67 $@19: ε

   68 else: ELSE $@19 nested_commands
   69     | ε

   70 nested_commands: T_BEGIN commands T_END
   71                | command

   72 $@20: ε

   73 procedure_call: IDENT $@20 exp_args

   74 $@21: ε

   75 exp_args: '(' $@21 expression_list ')'
   76         | ε

   77 $@22: ε

   78 expression_list: expression $@22 ',' expression_list
   79                | expression

   80 expression: simple_expression '=' simple_expression
   81           | simple_expression DIFFERENT simple_expression
   82           | simple_expression '<' simple_expression
   83           | simple_expression '>' simple_expression
   84           | simple_expression LESS_EQUAL simple_expression
   85           | simple_expression GREATER_EQUAL simple_expression
   86           | simple_expression

   87 simple_expression: simple_expression '+' term
   88                  | simple_expression '-' term
   89                  | simple_expression '|' term
   90                  | term

   91 term: term '*' factor
   92     | term DIV factor
   93     | term '&' factor
   94     | factor

   95 factor: '!' factor
   96       | sign factor
   97       | IDENT
   98       | NUM
   99       | TRUE
  100       | FALSE
  101       | '(' expression ')'

  102 $@23: ε

  103 $@24: ε

  104 factor: IDENT $@23 '(' $@24 expression_list ')'

  105 sign: '+'
  106     | '-'


